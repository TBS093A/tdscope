build/
dist/
*.egg-info/
src/tdscope/_version.py
.DS_Store

# Never commit real thread dumps: they contain hostnames, URLs, user data.
/dumps/

# Default names of reports and charts exported from the TUI (they contain dump data).
tdscope-*.txt
tdscope-*.json
tdscope-*.html

# Private words (client names, hosts) checked by the pre-commit hook; never commit this.
.private-patterns
